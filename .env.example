# HTTP
HTTP_PORT=8082
METRICS_PORT=8083

# PostgreSQL
DATABASE_URL=postgresql://video_user:video_pass@postgres-videos:5432/videos?sslmode=disable

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_UPLOAD_BUCKET=uploads
MINIO_ZIP_BUCKET=zips

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=fiapx.video
RABBITMQ_PROCESSING_Q=video.processing
RABBITMQ_STATUS_Q=video.status

# Redis
REDIS_URL=redis://redis:6379/0

# Keycloak
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=fiapx

# Observabilidade
JAEGER_ENDPOINT=http://jaeger:4318/v1/traces
LOG_LEVEL=info

# Upload
MAX_UPLOAD_SIZE_MB=500
